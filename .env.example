# Copy this file to .env and fill in real values.
# Never commit the real .env file.

APP_ENV=local
# When APP_DEBUG=true, API error responses include debug details.
# Always set this to false in production.
APP_DEBUG=true

# Frontend origin allowed to call the API with credentials when it is
# NOT same-origin (e.g. a separate dev server without the Vite proxy).
# Leave empty for same-origin deployments (recommended).
CORS_ALLOWED_ORIGIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qr_menu_dev
DB_USER=qr_menu_dev
DB_PASS=change_me
DB_CHARSET=utf8mb4

# Name of the PHP session cookie used for admin auth.
SESSION_NAME=qr_menu_admin
# Admin session lifetime in seconds.
SESSION_LIFETIME=7200

# Login brute-force protection.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Public URL of the uploads directory (served as static files).
UPLOADS_URL=/uploads
# Absolute or project-root-relative filesystem path to the uploads directory.
UPLOADS_PATH=uploads
UPLOAD_MAX_BYTES=5242880

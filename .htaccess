# Deployed verbatim to the site root by the Vite build.
# Protects secrets and source files that may end up next to the built
# frontend on shared hosting (see README "Production deployment").

RewriteEngine On

# Block dotfiles (.env, .git, .htpasswd, ...).
RewriteRule "(^|/)\." - [F,L]

<FilesMatch "\.(env|sql|log|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
